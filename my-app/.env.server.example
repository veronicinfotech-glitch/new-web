# Instagram API Server Configuration (Instagram API with Instagram Login)
#
# Copy this file to .env.server and fill in your real credentials.
# NEVER commit .env.server to git — it is already in .gitignore.
#
# ─────────────────────────────────────────────────────────────────────
# API USED: Instagram API with Instagram Login
# Host:     graph.instagram.com  (NOT graph.facebook.com)
# Scope:    instagram_business_basic
# Docs:     https://developers.facebook.com/docs/instagram-platform/instagram-api-with-instagram-login
#
# Requirements:
#   - Meta App: "Veronic Website-IG" (or your app name)
#   - App Type: Business
#   - Product added: Instagram (under "API Setup with Instagram Login")
#   - Instagram account: @veronic_infotech must be a Professional account
#     (Business or Creator — NOT a personal account)
#   - You must add and accept the tester invitation OR your account is the app owner
#
# ─────────────────────────────────────────────────────────────────────
# HOW TO GET A LONG-LIVED ACCESS TOKEN
#
# Step 1: In Meta App Dashboard → Instagram → API Setup with Instagram Login
#         → "Generate Token" button next to your connected account.
#         This gives you a SHORT-LIVED Instagram User Token (valid 1 hour).
#
# Step 2: Exchange it for a LONG-LIVED token (valid 60 days):
#
#   GET https://graph.instagram.com/access_token
#       ?grant_type=ig_exchange_token
#       &client_id={YOUR_APP_ID}
#       &client_secret={YOUR_APP_SECRET}
#       &access_token={SHORT_LIVED_TOKEN}
#
#   Returns: { "access_token": "...", "token_type": "bearer", "expires_in": 5183944 }
#
# Step 3: (Optional) Refresh it before it expires — tokens can be refreshed
#   within the last 30 days of their 60-day window:
#
#   GET https://graph.instagram.com/refresh_access_token
#       ?grant_type=ig_refresh_token
#       &access_token={LONG_LIVED_TOKEN}
#
# ─────────────────────────────────────────────────────────────────────
# WHAT INSTAGRAM_USER_ID IS FOR (optional but useful):
#
# The Instagram API with Instagram Login uses /me (token-based) so a numeric
# user ID is NOT required for the backend to function. However you can record
# it here for reference or debugging purposes.
#
# To find your numeric Instagram User ID, call the API after setting a token:
#   GET https://graph.instagram.com/v22.0/me?fields=id,username&access_token={TOKEN}
#
# ─────────────────────────────────────────────────────────────────────

# Your Long-Lived Instagram User Access Token
# Obtained from Meta App Dashboard → Instagram → API Setup with Instagram Login
# → Generate Token, then exchanged via graph.instagram.com/access_token
# Example: IGAAxxxxxxxxxxxxxx...
INSTAGRAM_ACCESS_TOKEN=your_long_lived_instagram_access_token_here

# Your numeric Instagram User ID (optional — for reference/debugging only)
# The backend does NOT need this to work; it uses the /me endpoint.
# Example: 17841400000000000
INSTAGRAM_USER_ID=your_instagram_numeric_user_id_here

# Server port (default: 3001 — must not conflict with React's port 3000)
PORT=3001
